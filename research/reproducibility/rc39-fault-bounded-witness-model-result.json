    "C9_resettable_counter_collides": true,
    "C10_strict_majority_threshold_matches_grid": true,
    "C11_common_cause_defeats_all_tested_redundancy": true,
    "C12_common_cause_symbolic_counterexample_is_size_independent": true
  },
