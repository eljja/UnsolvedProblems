{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eljja.github.io/UnsolvedProblems/research/reproducibility/role-separated-enrollment-ledger.schema.json",
  "title": "RC32 role-separated package-enrollment public ledger",
  "type": "object",
  "required": ["profile", "protocolId", "frozenAt", "records", "ledgerDigest", "qualification"],
  "properties": {
    "profile": { "const": "urn:unsolved-problems:role-separated-enrollment-ledger:0.7" },
    "protocolId": { "const": "ROLE-SEPARATED-PACKAGE-ENROLLMENT-0.7" },
    "frozenAt": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["enrollmentId", "studyId", "packageCommitment", "duplicateOf", "scopeKeyId", "custodyObservationDigest"],
        "properties": {
          "enrollmentId": { "type": "string", "pattern": "^ENR-[A-C]-[1-3]$" },
          "studyId": { "enum": ["STUDY-A", "STUDY-B", "STUDY-C"] },
          "packageCommitment": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "duplicateOf": { "type": ["string", "null"], "pattern": "^ENR-[A-C]-1$" },
          "scopeKeyId": { "type": "string", "pattern": "^KEY-STUDY-[A-C]$" },
          "custodyObservationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "ledgerDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "qualification": { "const": "synthetic-only" }
  },
  "additionalProperties": false
}
