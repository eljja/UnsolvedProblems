{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eljja.github.io/UnsolvedProblems/research/reproducibility/rc59-acquisition-manifest.schema.json",
  "title": "RC59 battery acquisition manifest",
  "description": "Outcome-blind specimen, protocol, physical-resource, calibration, and file-lineage contract for a 48-cell confirmation cohort.",
  "type": "object",
  "required": ["manifestId", "cycleId", "stage", "outcomeAccessState", "domainSpecification", "resourceRegistry", "specimens", "cycle480BranchRegister", "approvals"],
  "properties": {
    "manifestId": {"type": "string", "minLength": 8},
    "cycleId": {"const": "RC-2026-59"},
    "stage": {"enum": ["planning", "physical-use-ready", "cycle-480-adjudication", "outcome-opened"]},
    "outcomeAccessState": {"enum": ["closed", "opened-once-after-all-gates"]},
    "domainSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditionId", "chemistry", "cellDesign", "manufacturingLotDefinition", "formationRecipeId", "temperatureSetpoint", "temperatureTolerance", "chargeProtocolId", "dischargeProtocolId", "voltageWindow", "endpointDefinitionId", "signedSpecificationSha256"],
      "properties": {
        "conditionId": {"type": "string"},
        "chemistry": {"type": "string"},
        "cellDesign": {"type": "string"},
        "manufacturingLotDefinition": {"type": "string"},
        "formationRecipeId": {"type": "string"},
        "temperatureSetpoint": {"type": "number"},
        "temperatureTolerance": {"type": "number", "exclusiveMinimum": 0},
        "chargeProtocolId": {"type": "string"},
        "dischargeProtocolId": {"type": "string"},
        "voltageWindow": {"type": "string"},
        "endpointDefinitionId": {"type": "string"},
        "signedSpecificationSha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "resourceRegistry": {
      "type": "array",
      "minItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceId", "resourceType", "physicalLocation", "calibrationRecordId", "maintenanceRecordId", "availableFrom", "availableThrough"],
        "properties": {
          "resourceId": {"type": "string"},
          "resourceType": {"enum": ["chamber", "fixture-group", "cycler-channel", "temperature-sensor", "pressure-sensor", "expansion-sensor"]},
          "physicalLocation": {"type": "string"},
          "calibrationRecordId": {"type": "string"},
          "maintenanceRecordId": {"type": "string"},
          "availableFrom": {"type": "string", "format": "date-time"},
          "availableThrough": {"type": "string", "format": "date-time"}
        }
      }
    },
    "specimens": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["specimenId", "physicalSerialCommitment", "manufacturingBlockId", "conditionId", "chamberId", "fixtureGroupId", "channelId", "startWave", "rawFileUri", "rawFileSha256", "cycle480QcStatus", "administrativeCensoringReason"],
        "properties": {
          "specimenId": {"type": "string", "pattern": "^RC59-B[0-9]{2}-S[1-4]$"},
          "physicalSerialCommitment": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "manufacturingBlockId": {"type": "string", "pattern": "^B[0-9]{2}$"},
          "conditionId": {"type": "string"},
          "chamberId": {"type": "string"},
          "fixtureGroupId": {"type": "string"},
          "channelId": {"type": "string"},
          "startWave": {"type": "integer", "minimum": 1, "maximum": 6},
          "rawFileUri": {"type": "string"},
          "rawFileSha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "cycle480QcStatus": {"enum": ["pending", "usable", "administratively-censored", "instrument-failure", "safety-stop"]},
          "administrativeCensoringReason": {"type": ["string", "null"]}
        }
      }
    },
    "cycle480BranchRegister": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionTime", "allowedInputs", "forbiddenInputs", "branches"],
      "properties": {
        "decisionTime": {"type": "string"},
        "allowedInputs": {"type": "array", "contains": {"const": "cycle480QcStatus"}},
        "forbiddenInputs": {"type": "array", "contains": {"const": "lifetime"}},
        "branches": {"type": "array", "minItems": 3, "maxItems": 3}
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["laboratorySafetyOwner", "metrologyOwner", "dataCustodian", "independentAdjudicator", "allSignedBeforePhysicalUse"],
      "properties": {
        "laboratorySafetyOwner": {"type": ["string", "null"]},
        "metrologyOwner": {"type": ["string", "null"]},
        "dataCustodian": {"type": ["string", "null"]},
        "independentAdjudicator": {"type": ["string", "null"]},
        "allSignedBeforePhysicalUse": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"stage": {"const": "physical-use-ready"}}, "required": ["stage"]},
      "then": {
        "properties": {
          "outcomeAccessState": {"const": "closed"},
          "approvals": {"properties": {"allSignedBeforePhysicalUse": {"const": true}}}
        }
      }
    },
    {
      "if": {"properties": {"stage": {"enum": ["planning", "physical-use-ready", "cycle-480-adjudication"]}}, "required": ["stage"]},
      "then": {"properties": {"outcomeAccessState": {"const": "closed"}}}
    }
  ],
  "additionalProperties": false
}
