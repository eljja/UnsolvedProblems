{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eljja.github.io/UnsolvedProblems/research/reproducibility/attestation-evidence.schema.json",
  "title": "RC30 EAT-compatible chiplet evidence profile",
  "description": "A JSON research profile aligned with RFC 9711 claim semantics and carried as an RFC 9999 CMW record. It is not an IETF-registered EAT profile.",
  "type": "object",
  "required": ["profile", "cmw", "evidenceId", "issuedAt", "nonce", "counter", "attester", "target", "traceHead", "measurements", "referenceVersion", "policyDigest", "demonstrationIntegrity"],
  "properties": {
    "profile": { "const": "urn:unsolved-problems:chiplet-evidence:0.5" },
    "cmw": {
      "type": "object",
      "required": ["mediaType", "indicator"],
      "properties": {
        "mediaType": { "const": "application/cmw+json" },
        "indicator": { "const": "evidence" }
      },
      "additionalProperties": false
    },
    "evidenceId": { "type": "string", "pattern": "^EV-[A-Z0-9-]{6,40}$" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "nonce": { "type": "string", "pattern": "^[A-F0-9]{32}$" },
    "counter": { "type": "integer", "minimum": 1 },
    "attester": {
      "type": "object",
      "required": ["instanceId", "keyId", "endorserId"],
      "properties": {
        "instanceId": { "type": "string", "pattern": "^PKG-[A-Z0-9-]+$" },
        "keyId": { "type": "string", "pattern": "^KEY-[A-Z0-9-]+$" },
        "endorserId": { "type": "string", "pattern": "^ORG-[A-Z0-9-]+$" }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["componentId", "vendor", "processFamily", "lot", "packageId"],
      "properties": {
        "componentId": { "type": "string", "pattern": "^DIE-[A-Z0-9-]+$" },
        "vendor": { "type": "string", "pattern": "^VENDOR-[A-Z]+$" },
        "processFamily": { "enum": ["P1", "P2"] },
        "lot": { "type": "string", "pattern": "^LOT-[1-3]$" },
        "packageId": { "type": "string", "pattern": "^PKG-[A-Z0-9-]+$" }
      },
      "additionalProperties": false
    },
    "traceHead": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "measurements": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["measurementUnitId", "kind", "value", "unit", "uncertainty", "context"],
        "properties": {
          "measurementUnitId": { "type": "string", "pattern": "^MU-[A-Z0-9-]+$" },
          "kind": { "enum": ["physical-response-distance", "trace-digest"] },
          "value": { "type": ["number", "string"] },
          "unit": { "enum": ["normalized-distance", "sha-256"] },
          "uncertainty": { "type": "number", "minimum": 0 },
          "context": {
            "type": "object",
            "required": ["temperatureC", "voltageV", "ageHours"],
            "properties": {
              "temperatureC": { "type": "number", "minimum": -55, "maximum": 150 },
              "voltageV": { "type": "number", "minimum": 0.5, "maximum": 2 },
              "ageHours": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "referenceVersion": { "type": "string", "pattern": "^REF-[0-9]+$" },
    "policyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "demonstrationIntegrity": {
      "type": "object",
      "required": ["algorithm", "keyId", "digest"],
      "properties": {
        "algorithm": { "const": "sha-256-demo-binding-not-a-signature" },
        "keyId": { "type": "string", "pattern": "^KEY-[A-Z0-9-]+$" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
