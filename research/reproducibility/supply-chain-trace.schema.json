{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eljja.github.io/UnsolvedProblems/research/reproducibility/supply-chain-trace.schema.json",
  "title": "RC30 SCITT-aligned supply-chain trace statement profile",
  "description": "A research statement chain aligned with RFC 9943 transparency concepts. It is not a registered SCITT statement type or a production transparency service.",
  "type": "object",
  "required": ["profile", "traceId", "subject", "events", "headDigest", "receipt"],
  "properties": {
    "profile": { "const": "urn:unsolved-problems:chiplet-trace:0.5" },
    "traceId": { "type": "string", "pattern": "^TRACE-[A-Z0-9-]+$" },
    "subject": {
      "type": "object",
      "required": ["packageId", "componentIds"],
      "properties": {
        "packageId": { "type": "string", "pattern": "^PKG-[A-Z0-9-]+$" },
        "componentIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^DIE-[A-Z0-9-]+$" } }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["sequence", "eventType", "actorId", "occurredAt", "subjectDigest", "previousDigest", "eventDigest", "statementDigest"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "eventType": { "enum": ["die-manufactured", "package-assembled", "custody-transferred", "package-received"] },
          "actorId": { "type": "string", "pattern": "^ORG-[A-Z0-9-]+$" },
          "occurredAt": { "type": "string", "format": "date-time" },
          "subjectDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "previousDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "eventDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "statementDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "headDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "receipt": {
      "type": "object",
      "required": ["serviceId", "statementDigest", "issuedAt", "receiptDigest"],
      "properties": {
        "serviceId": { "type": "string", "pattern": "^TS-[A-Z0-9-]+$" },
        "statementDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
